# Copy to .env locally. Never commit real secrets.
POSTGRES_DB=fuellog
POSTGRES_USER=fuellog
POSTGRES_PASSWORD=
# Base64 of PEM: RSA private PKCS8 and matching public X509, minimum 2048 bits.
FUELLOG_SECURITY_PRIVATE_KEY_BASE64=
FUELLOG_SECURITY_PUBLIC_KEY_BASE64=
# Base64 of 32 independently generated random bytes for AES-256-GCM TOTP encryption.
FUELLOG_SECURITY_TOTP_ENCRYPTION_KEY_BASE64=
FUELLOG_SECURITY_ISSUER=fuellog-api
FUELLOG_SECURITY_AUDIENCE=fuellog-mobile
FUELLOG_CORS_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
API_BIND_ADDRESS=127.0.0.1
API_PORT=8080
# ViKash HTTP v1. Disabled until an operator registers this confidential client and exact callbacks.
FUELLOG_VIKASH_ENABLED=false
FUELLOG_VIKASH_BASE_URL=
FUELLOG_VIKASH_CLIENT_ID=fuellog
FUELLOG_VIKASH_CLIENT_SECRET=
FUELLOG_VIKASH_CALLBACK_URL=
FUELLOG_VIKASH_WEB_RETURN_URL=
FUELLOG_VIKASH_NATIVE_RETURN_URL=
# Dedicated AES-256-GCM key: Base64 of 32 independent random bytes, separate from TOTP.
FUELLOG_VIKASH_ENCRYPTION_KEY_BASE64=
