{
  "expo": {
    "name": "FuelLog",
    "slug": "fuellog",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/mascote_icon_square.png",
    "scheme": "fuellog",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.fuellog.app",
      "infoPlist": {
        "NSFaceIDUsageDescription": "FuelLog utiliza o Face ID para desbloquear sua conta com segurança neste aparelho."
      }
    },
    "android": {
      "package": "com.fuellog.app",
      "adaptiveIcon": {
        "backgroundColor": "#10203B",
        "foregroundImage": "./assets/brand/mascote_icon_square.png"
      },
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/brand/mascote_icon_square.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-secure-store",
        {
          "faceIDPermission": "FuelLog utiliza o Face ID para desbloquear sua conta com segurança neste aparelho."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "FuelLog utiliza o Face ID para desbloquear sua conta com segurança neste aparelho."
        }
      ],
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F5F3EE",
          "dark": {
            "backgroundColor": "#0A1526"
          },
          "image": "./assets/brand/mascote_icon_square.png",
          "imageWidth": 140
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "FuelLog precisa da sua localização para registrar as coordenadas do abastecimento."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
