{
  "expo": {
    "name": "FuelLog",
    "slug": "fuellog",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/mascote_icon_square.png",
    "scheme": "fuellog",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.fuellog.app"
    },
    "android": {
      "package": "com.fuellog.app",
      "adaptiveIcon": {
        "backgroundColor": "#10203B",
        "foregroundImage": "./assets/brand/mascote_icon_square.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/brand/mascote_icon_square.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F5F3EE",
          "dark": {
            "backgroundColor": "#0A1526"
          },
          "image": "./assets/brand/mascote_icon_square.png",
          "imageWidth": 140
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
