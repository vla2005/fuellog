# Base completa da API FuelLog (inclui /api/v1)
# Web / Desktop no mesmo host:
EXPO_PUBLIC_API_URL=http://localhost:8080/api/v1

# Android Emulator (substitua acima quando rodar no emulador Android):
# EXPO_PUBLIC_API_URL=http://10.0.2.2:8080/api/v1

# Aparelho físico na mesma rede Wi-Fi (use o IP LAN real da máquina host, nunca localhost):
# EXPO_PUBLIC_API_URL=http://192.168.1.100:8080/api/v1

# URLs jurídicas oficiais opcionais (deixe em branco enquanto ainda não publicadas; o app informa a indisponibilidade com transparência):
EXPO_PUBLIC_TERMS_URL=
EXPO_PUBLIC_PRIVACY_URL=
